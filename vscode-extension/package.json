{
  "name": "simbionte",
  "displayName": "Simbionte",
  "description": "Painel ao vivo do Claude Code: progresso dos planos, arquivos tocados e estado da sessão (trabalhando, aguardando você, comando rodando, travada). | Live Claude Code panel: plan progress, touched files and session state.",
  "version": "1.1.0",
  "publisher": "OSCARWILDERROJASRIVERO4849",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragonfurioso35-art/simbionte-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dragonfurioso35-art/simbionte-vscode/issues"
  },
  "homepage": "https://github.com/dragonfurioso35-art/simbionte-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "agent",
    "hooks",
    "progress",
    "plans",
    "superpowers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simbionte",
          "title": "Simbionte",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "simbionte": [
        {
          "type": "webview",
          "id": "simbionte.painel",
          "name": "Simbionte"
        }
      ]
    },
    "commands": [
      {
        "command": "simbionte.instalarHooks",
        "title": "Simbionte: Instalar hooks do Claude Code"
      },
      {
        "command": "simbionte.removerHooks",
        "title": "Simbionte: Remover hooks do Claude Code"
      }
    ],
    "configuration": {
      "title": "Simbionte",
      "properties": {
        "simbionte.limiteTravadoMin": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Minutos sem nenhum sinal, com o Claude Code trabalhando, até alertar \"possivelmente travada\". Esperar você, rodar um comando ou sessão encerrada nunca alertam."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepare.js"
  }
}
